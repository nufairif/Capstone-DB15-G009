# ==============================================================================
# Konfigurasi AI Engine & Observability — Toko Firaza (DB15-G009)
# ==============================================================================

# 1. Endpoint Inference LLM (Langsung ke vLLM di Google Colab via Ngrok, tanpa 9router)
#    Contoh Ngrok: https://abcd-1234.ngrok-free.app/v1
#    Cadangan Lokal (Ollama): http://localhost:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

# Pengaturan Ngrok (dipakai di notebook Colab / jika ingin tunnel langsung)
NGROK_AUTHTOKEN=

# 2. Konfigurasi Instructor & Validasi Kontrak Pydantic
INSTRUCTOR_MODE=json
INSTRUCTOR_MAX_RETRIES=2
# Jika false, server LLM yang mati akan mengembalikan 503.
# Catatan: kegagalan validasi Pydantic dari LLM SELALU ditolak (HTTP 422), tidak pernah di-bypass.
ALLOW_OFFLINE_FALLBACK=true

# 3. Konfigurasi RAG (LlamaIndex + ChromaDB)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=ai-engine/models/chroma_db

# 4. Konfigurasi Observability, Logging, & Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
